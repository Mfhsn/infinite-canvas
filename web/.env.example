# Docker Compose / runtime env.js 示例。
# 注意：这些 VITE_* 值会暴露到浏览器端；不要在公网多人环境里放私密 Key。

# 画布 Agent 侧栏显示开关；false 时同时隐藏顶部 Agent 入口且不挂载对话侧栏。
VITE_SHOW_AGENT_SIDEBAR=true

# 本地开发存储设置。browser 不需要启动 Storage Server；mysql 会将
# /api/storage 代理到 STORAGE_API_URL。数据库凭据不会进入 Vite 客户端。
DATA_STORAGE_DRIVER=browser
STORAGE_NAMESPACE=default
STORAGE_API_PORT=3001
STORAGE_API_URL=http://127.0.0.1:3001
STORAGE_MAX_FILE_MB=128
STORAGE_MAX_DOCUMENT_MB=16

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=infinite_canvas
MYSQL_USER=infinite_canvas
MYSQL_PASSWORD=infinite_canvas
MYSQL_CONNECTION_LIMIT=10
MYSQL_CONNECT_ATTEMPTS=30
MYSQL_CONNECT_RETRY_MS=2000
MYSQL_SSL=false

# 是否每次启动都用环境变量覆盖浏览器本地保存的渠道/模型配置。
# false/空：只作为首次默认值；true：强制以环境变量为准。
# 本项目使用固定环境 Token，建议保持 true，避免浏览器本地旧配置覆盖 .env。
VITE_AI_CONFIG_OVERRIDE=true

# 单渠道写法：适合只配置一个默认渠道。
# 调用格式可选：openai / gemini / dream（dream = api接口示例）
VITE_AI_CHANNEL_ID=dream-default
VITE_AI_CHANNEL_NAME=API接口示例
VITE_AI_API_FORMAT=dream
VITE_AI_BASE_URL=https://106.75.147.147
VITE_AI_LLM_URL=https://106.75.147.147/api/v1/ai-service/llm/chat
# LLM 最大输出 token 数；实际请求和积分预估使用同一个值。
VITE_AI_LLM_MAX_COMPLETION_TOKENS=4096
# Base URL 为 IP 且 HTTPS 证书签发给域名时，用该域名校验证书。
VITE_AI_TLS_SERVER_NAME=prod-cn.just4fun.sg
# 当前内置服务在客户端发送 SNI 时会重置 TLS；代理需禁用 SNI，但仍按上面的域名校验证书。
VITE_AI_TLS_DISABLE_SNI=true
# 本地开发代理等待单次 API 请求的最长时间（毫秒）。
VITE_AI_PROXY_TIMEOUT_MS=180000
# 本地代理建立 CONNECT/TLS 连接的最长时间（毫秒）。
VITE_AI_PROXY_CONNECT_TIMEOUT_MS=30000
# 图片/视频异步任务的最长轮询时间（毫秒），默认 15 分钟。
VITE_AI_TASK_TIMEOUT_MS=900000
# 固定 Bearer Token。项目不会调用登录或 Refresh Token 接口；更新后需重启服务/开发服务器。
VITE_AI_API_KEY=
# 必填；Dream 图片生成及积分预估的平台 ID。
VITE_DREAM_IMAGE_PLATFORM_ID=6
# 必填；Dream 视频生成及积分预估的平台 ID。
VITE_DREAM_VIDEO_PLATFORM_ID=7
# TTS/其他兼容请求的平台 ID。
VITE_AI_PLATFORM_ID=6
# true 传递当前平台 local_project_id；false 时图片/视频 Dream 生成请求完全省略 project_id。
VITE_DREAM_INCLUDE_PROJECT_ID=true
# 留空时使用内置模型：4 个图片模型、4 个视频模型、4 个文本模型和 TTS 端点选项。
VITE_AI_MODELS=

# 多渠道写法：如果填写，会优先于上面的单渠道写法。
# VITE_AI_CHANNELS_JSON=[{"id":"dream-default","name":"API接口示例","apiFormat":"dream","baseUrl":"https://prod-cn.your-api-server.com","apiKey":"","platformId":6}]

VITE_DEFAULT_IMAGE_MODEL=dream-default::doubao-seedream-4.5
VITE_DEFAULT_VIDEO_MODEL=dream-default::doubao-seedance-2-0-260128
VITE_DEFAULT_TEXT_MODEL=dream-default::doubao-1.5-pro
VITE_DEFAULT_AUDIO_MODEL=dream-default::tts-synthesize

VITE_DEFAULT_IMAGE_SIZE=1:1
VITE_DEFAULT_IMAGE_QUALITY=2k
VITE_DEFAULT_IMAGE_COUNT=1
VITE_DEFAULT_CANVAS_IMAGE_COUNT=3
VITE_DEFAULT_VIDEO_SECONDS=5
VITE_DEFAULT_VIDEO_QUALITY=720
VITE_DEFAULT_AUDIO_VOICE=alloy
VITE_DEFAULT_AUDIO_FORMAT=mp3
VITE_DEFAULT_AUDIO_SPEED=1
VITE_DEFAULT_SYSTEM_PROMPT=
VITE_DOC_URL=https://docs.canvas.best
