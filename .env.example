# Docker Compose / runtime env.js 示例。
# 注意：这些 VITE_* 值会暴露到浏览器端；不要在公网多人环境里放私密 Key。

# 同源部署的画布子路径；必须以 / 开头和结尾。设为 / 可恢复根路径部署。
VITE_APP_BASE_PATH=/canvas/
# false：Docker 端口只绑定 127.0.0.1，仅供本机 Nginx 使用；true：绑定 0.0.0.0，便于临时公网调试。
# 使用 ./docker/compose-cn.sh 启动时该开关生效。
CANVAS_PUBLIC_ACCESS=true
CANVAS_BIND_HOST=0.0.0.0
# 主站 Nginx 容器所在的 Docker 网络名；使用 docker inspect aimanga-nginx 查询。
AI_MANGA_DOCKER_NETWORK=ai-manga_default
# 顶部导航和操作区显示开关：true 显示，true 以外的值均隐藏。
VITE_SHOW_IMAGE_WORKBENCH=true
VITE_SHOW_VIDEO_WORKBENCH=true
VITE_SHOW_GITHUB=true
VITE_SHOW_DOCS=true
VITE_SHOW_CONFIG=true
VITE_SHOW_SHORTCUTS=true

# 数据存储驱动：browser 使用浏览器 localForage/IndexedDB；mysql 使用服务端 MySQL。
# MySQL 凭据只由 Storage Server 读取，不会写入前端 env.js。
DATA_STORAGE_DRIVER=browser
STORAGE_NAMESPACE=default
STORAGE_MAX_FILE_MB=128
STORAGE_MAX_DOCUMENT_MB=16
STORAGE_API_PORT=3001
STORAGE_API_URL=http://127.0.0.1:3001

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=infinite_canvas
MYSQL_USER=infinite_canvas
MYSQL_PASSWORD=infinite_canvas
MYSQL_ROOT_PASSWORD=infinite_canvas_root
MYSQL_CONNECTION_LIMIT=10
MYSQL_CONNECT_ATTEMPTS=30
MYSQL_CONNECT_RETRY_MS=2000
MYSQL_SSL=false

# 外部平台 Integration。以下变量仅由 Storage Server 读取，不会写入浏览器 env.js。
INTEGRATION_ENABLED=false
INTEGRATION_BASE_URL=https://106.75.147.147
INTEGRATION_TLS_SERVER_NAME=prod-cn.just4fun.sg
INTEGRATION_TLS_DISABLE_SNI=true
# 可选；留空时自动选择平台返回的第一个可访问项目。
INTEGRATION_EXTERNAL_PROJECT_ID=
# 上游 context 未返回 source_system 时使用该值；启用 Integration 后不能为空。
INTEGRATION_SOURCE_SYSTEM=
# 启用 Integration 时必须设置至少 32 字节的高强度随机值，例如：openssl rand -base64 48
# 不要提交真实密钥；更换该值会使已有登录会话全部失效。
INTEGRATION_SESSION_SECRET=
INTEGRATION_COOKIE_NAME=infinite_canvas_session
# 生产环境默认 true；仅本地纯 HTTP 开发设为 false。
INTEGRATION_COOKIE_SECURE=true
INTEGRATION_SESSION_TTL_SECONDS=86400
INTEGRATION_CONNECT_TIMEOUT_MS=30000
INTEGRATION_REQUEST_TIMEOUT_MS=180000

# 是否每次启动都用环境变量覆盖浏览器本地保存的渠道/模型配置。
# false/空：只作为首次默认值；true：强制以环境变量为准。
# 固定 Token 兼容模式建议保持 true，避免浏览器本地旧配置覆盖 .env。
# Integration 模式由服务端会话注入 local_token，不再把固定 Token 发给浏览器。
VITE_AI_CONFIG_OVERRIDE=true

# 单渠道写法：适合只配置一个默认渠道。
# 调用格式可选：openai / gemini / dream（dream = api接口示例）
VITE_AI_CHANNEL_ID=dream-default
VITE_AI_CHANNEL_NAME=API接口示例
VITE_AI_API_FORMAT=dream
VITE_AI_BASE_URL=https://106.75.147.147
# 内置 LLM 独立使用 HTTPS 端点；浏览器通过同源 Dream 代理访问。
VITE_AI_LLM_URL=https://106.75.147.147/api/v1/ai-service/llm/chat
VITE_AI_LLM_PLATFORM_CODE=ucloud
# Base URL 为 IP 且 HTTPS 证书签发给域名时，用该域名校验证书。
VITE_AI_TLS_SERVER_NAME=prod-cn.just4fun.sg
# 当前内置服务在客户端发送 SNI 时会重置 TLS；本地 Vite 代理需禁用 SNI，但仍按上面的域名校验证书。
VITE_AI_TLS_DISABLE_SNI=true
# 本地开发代理等待单次 API 请求的最长时间（毫秒）。
VITE_AI_PROXY_TIMEOUT_MS=180000
# 本地代理建立 CONNECT/TLS 连接的最长时间（毫秒）。
VITE_AI_PROXY_CONNECT_TIMEOUT_MS=30000
# 图片/视频异步任务的最长轮询时间（毫秒），默认 15 分钟。
VITE_AI_TASK_TIMEOUT_MS=900000
# 仅 INTEGRATION_ENABLED=false 的兼容模式使用固定 Bearer Token。
# Integration 模式请留空；Docker 构建和运行时会主动过滤该浏览器变量。
VITE_AI_API_KEY=
# Dream 请求平台 ID：当前图片/视频文档要求 6=ModelVerse；TTS 中 6=Minimax。
VITE_AI_PLATFORM_ID=6
# 留空时使用内置模型：2 个 Seedream 图片模型、2 个 Seedance 视频模型、doubao-1.5-pro 文本模型和 TTS 端点选项。
VITE_AI_MODELS=

# 多渠道写法：如果填写，会优先于上面的单渠道写法。
# VITE_AI_CHANNELS_JSON=[{"id":"dream-default","name":"API接口示例","apiFormat":"dream","baseUrl":"https://prod-cn.your-api-server.com","apiKey":"","platformId":6}]

VITE_DEFAULT_IMAGE_MODEL=dream-default::doubao-seedream-4.5
VITE_DEFAULT_VIDEO_MODEL=dream-default::doubao-seedance-1-5-pro-251215
VITE_DEFAULT_TEXT_MODEL=dream-default::doubao-1.5-pro
VITE_DEFAULT_AUDIO_MODEL=dream-default::tts-synthesize

VITE_DEFAULT_IMAGE_SIZE=1:1
VITE_DEFAULT_IMAGE_QUALITY=2k
VITE_DEFAULT_IMAGE_COUNT=1
VITE_DEFAULT_CANVAS_IMAGE_COUNT=3
VITE_DEFAULT_VIDEO_SECONDS=5
VITE_DEFAULT_VIDEO_QUALITY=720
VITE_DEFAULT_AUDIO_VOICE=alloy
VITE_DEFAULT_AUDIO_FORMAT=mp3
VITE_DEFAULT_AUDIO_SPEED=1
VITE_DEFAULT_SYSTEM_PROMPT=
VITE_DOC_URL=https://docs.canvas.best
