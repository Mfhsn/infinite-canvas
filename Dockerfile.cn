# syntax=docker/dockerfile:1.7

# 国内 Docker Hub 镜像代理，可在构建时通过 --build-arg 覆盖。
ARG BUN_IMAGE=docker.m.daocloud.io/oven/bun:1.3.13
ARG NODE_IMAGE=docker.m.daocloud.io/library/node:20-alpine
ARG NPM_REGISTRY=https://registry.npmmirror.com

# 构建 Web 前端。
FROM ${BUN_IMAGE} AS web-build

ARG NPM_REGISTRY
WORKDIR /app/web

COPY web/package.json web/bun.lock ./
RUN --mount=type=cache,target=/root/.bun/install/cache \
    bun install --frozen-lockfile --registry="${NPM_REGISTRY}" --cache-dir=/root/.bun/install/cache

COPY VERSION /app/VERSION
COPY CHANGELOG.md /app/CHANGELOG.md
COPY web ./
RUN --mount=type=secret,id=app_env,target=/run/secrets/app_env,required=false \
    sh -eu -c '\
      if [ -f /run/secrets/app_env ]; then \
        if grep -Eiq "^INTEGRATION_ENABLED=(1|true)[[:space:]]*$" /run/secrets/app_env; then \
          grep -Ev "^(VITE_AI_API_KEY|VITE_AI_CHANNELS_JSON)=" /run/secrets/app_env > /app/.env; \
        else \
          cp /run/secrets/app_env /app/.env; \
        fi; \
      fi; \
      bun run build; \
      rm -f /app/.env'

# 编译同源 Storage API。
FROM ${NODE_IMAGE} AS storage-build

ARG NPM_REGISTRY
WORKDIR /app/storage-server

COPY storage-server/package.json storage-server/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm config set registry "${NPM_REGISTRY}" \
    && npm ci --no-audit --no-fund

COPY storage-server ./
RUN npm run build \
    && npm prune --omit=dev --no-audit --no-fund

# 生产运行镜像：同一个 3000 端口提供 Web、Storage API 和运行时环境配置。
FROM ${NODE_IMAGE}

WORKDIR /app
ENV NODE_ENV=production \
    STATIC_DIR=/app/web/dist \
    STORAGE_API_PORT=3000 \
    INFINITE_CANVAS_ENV_JS=/app/web/dist/env.js \
    TZ=Asia/Shanghai

COPY --from=web-build /app/web/dist /app/web/dist
COPY --from=storage-build /app/storage-server/dist /app/storage-server/dist
COPY --from=storage-build /app/storage-server/migrations /app/storage-server/migrations
COPY --from=storage-build /app/storage-server/package.json /app/storage-server/package.json
COPY --from=storage-build /app/storage-server/node_modules /app/storage-server/node_modules
COPY docker/runtime-env.sh /app/runtime-env.sh

RUN chmod +x /app/runtime-env.sh

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD ["sh", "-c", "wget -qO- \"http://127.0.0.1:3000${VITE_APP_BASE_PATH:-/}\" >/dev/null || exit 1"]

ENTRYPOINT ["/app/runtime-env.sh"]
CMD ["node", "/app/storage-server/dist/server.js"]
